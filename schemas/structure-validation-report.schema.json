{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/structure-validation-report.schema.json",
  "title": "Structure validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structureId",
    "isValid",
    "hasCriticalIssues",
    "metrics",
    "issues"
  ],
  "properties": {
    "structureId": {
      "type": "string",
      "minLength": 1
    },
    "isValid": {
      "type": "boolean"
    },
    "hasCriticalIssues": {
      "type": "boolean"
    },
    "metrics": {
      "type": "object"
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "code",
          "severity",
          "subjectId",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "severity": {
            "type": "string"
          },
          "subjectId": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": true
      }
    }
  }
}
