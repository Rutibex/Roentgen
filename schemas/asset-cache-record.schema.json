{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/asset-cache-record.schema.json",
  "title": "Roentgen procedural asset cache record",
  "type": "object",
  "additionalProperties": false,
  "required": ["kind", "id", "fingerprint", "contentChecksum", "payloadBytes", "payloadSha256"],
  "properties": {
    "kind": { "type": "string", "minLength": 1 },
    "id": { "type": "string", "minLength": 1 },
    "fingerprint": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "contentChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "payloadBytes": { "type": "integer", "minimum": 0 },
    "payloadSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
  }
}
