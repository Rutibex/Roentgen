{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/fact-record.schema.json",
  "title": "Roentgen Fact Record",
  "type": "object",
  "required": ["id", "predicateId", "subjectId", "truth", "scope", "provenanceId", "establishedTick"],
  "properties": {
    "id": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
    "predicateId": {"type": "string", "minLength": 1},
    "subjectId": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
    "object": {},
    "truth": {"enum": ["Unknown", "False", "True", "Disputed"]},
    "scope": {"enum": ["World", "Region", "Settlement", "Faction", "Actor", "Quest"]},
    "provenanceId": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"},
    "establishedTick": {"type": "integer", "minimum": 0},
    "expirationTick": {"type": ["integer", "null"], "minimum": 0},
    "revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
