{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roentgen Character Progression State",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "characterId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "level": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50
    },
    "experience": {
      "type": "integer",
      "minimum": 0
    },
    "attributes": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1,
        "maximum": 10
      }
    },
    "skills": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 100
      }
    },
    "specializedSkills": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "backgroundId": {
      "type": "string",
      "minLength": 1
    },
    "traitIds": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "perkRanks": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 1
      }
    },
    "unspentPoints": {
      "type": "object",
      "properties": {
        "skill": {
          "type": "integer"
        },
        "perk": {
          "type": "integer"
        },
        "attribute": {
          "type": "integer"
        }
      },
      "required": [
        "skill",
        "perk",
        "attribute"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "schemaVersion",
    "characterId",
    "level",
    "experience",
    "attributes",
    "skills",
    "specializedSkills",
    "backgroundId",
    "traitIds",
    "perkRanks",
    "unspentPoints"
  ]
}
