{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "sourceFactionId",
    "targetFactionId",
    "trustPermille",
    "fearPermille",
    "respectPermille"
  ],
  "properties": {
    "sourceFactionId": {
      "type": "string"
    },
    "targetFactionId": {
      "type": "string"
    },
    "trustPermille": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "fearPermille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "respectPermille": {
      "type": "integer",
      "minimum": -1000,
      "maximum": 1000
    },
    "agreements": {
      "type": "array"
    }
  },
  "title": "Roentgen Faction Relationship"
}
