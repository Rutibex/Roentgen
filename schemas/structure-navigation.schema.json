{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/structure-navigation.schema.json",
  "title": "Interior navigation product",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "structureId",
    "cells",
    "portals",
    "links",
    "coverPoints",
    "restrictedAreas",
    "flankingLinks",
    "checksum"
  ],
  "properties": {
    "structureId": {
      "type": "string",
      "minLength": 1
    },
    "cells": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "portals": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "links": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coverPoints": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "restrictedAreas": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "flankingLinks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    }
  }
}
