{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.local/schemas/weapon-family-v2.schema.json",
  "title": "Weapon Family V2",
  "type": "object",
  "required": [
    "id",
    "baseDamage",
    "baseCapacity",
    "requiredSlots"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "baseDamage": {
      "type": "array",
      "minItems": 1
    },
    "baseCapacity": {
      "type": "integer",
      "minimum": 0
    },
    "requiredSlots": {
      "type": "array",
      "uniqueItems": true
    }
  },
  "additionalProperties": true
}
