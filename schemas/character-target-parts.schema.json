{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/character-target-parts.schema.json",
  "title": "Roentgen Character Target Parts",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "characterId",
    "parts"
  ],
  "properties": {
    "characterId": {
      "type": "string",
      "pattern": "^[0-9a-f]{32}$"
    },
    "parts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "region",
          "boneName",
          "radiusMillimeters",
          "lengthMillimeters",
          "consequenceWeightPermille"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9a-f]{32}$"
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "region": {
            "type": "string"
          },
          "boneName": {
            "type": "string",
            "minLength": 1
          },
          "radiusMillimeters": {
            "type": "integer",
            "minimum": 1
          },
          "lengthMillimeters": {
            "type": "integer",
            "minimum": 1
          },
          "consequenceWeightPermille": {
            "type": "integer",
            "minimum": 0,
            "maximum": 1000
          }
        }
      }
    }
  }
}
