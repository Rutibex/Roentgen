{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/quest-kernel.schema.json",
  "title": "Roentgen Quest Kernel",
  "type": "object",
  "required": [
    "id",
    "version",
    "displayName",
    "slots",
    "objectives",
    "nodes",
    "routes",
    "recoveries",
    "dialogue",
    "consequences"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "displayName": {
      "type": "string",
      "minLength": 1
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "uniqueItems": true
    },
    "slots": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "typeId",
          "required",
          "unique"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "typeId": {
            "type": "string"
          },
          "required": {
            "type": "boolean"
          },
          "unique": {
            "type": "boolean"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "objectives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "routes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "recoveries": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "dialogue": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "consequences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "followUpHookIds": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
