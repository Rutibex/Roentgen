{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "settlementId",
    "kind",
    "capacity",
    "qualityPermille",
    "requiredInputs"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "settlementId": {
      "type": "string"
    },
    "kind": {
      "type": "string"
    },
    "capacity": {
      "type": "integer",
      "minimum": 0
    },
    "qualityPermille": {
      "type": "integer",
      "minimum": 0,
      "maximum": 1000
    },
    "requiredInputs": {
      "type": "object",
      "additionalProperties": {
        "type": "integer",
        "minimum": 0
      }
    }
  },
  "title": "Roentgen Settlement Service"
}
