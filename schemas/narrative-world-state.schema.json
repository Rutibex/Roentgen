{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/narrative-world-state.schema.json",
  "title": "Narrative World State",
  "type": "object",
  "required": ["schemaVersion", "tick", "day", "facts", "knowledgeClaims", "quests", "consumedEventIds", "revision"],
  "properties": {
    "schemaVersion": {"const": 16},
    "tick": {"type": "integer", "minimum": 0},
    "day": {"type": "integer", "minimum": 0},
    "facts": {"type": "array", "items": {"$ref": "fact-record.schema.json"}},
    "knowledgeClaims": {"type": "array", "items": {"type": "object"}},
    "generatedPlans": {"type": "array", "items": {"$ref": "generated-quest-plan.schema.json"}},
    "quests": {"type": "array", "items": {"type": "object"}},
    "conversations": {"type": "array", "items": {"type": "object"}},
    "rumors": {"type": "array", "items": {"type": "object"}},
    "consequences": {"type": "array", "items": {"type": "object"}},
    "recoveries": {"type": "array", "items": {"type": "object"}},
    "skillAttempts": {"type": "array", "items": {"type": "object"}},
    "consumedEventIds": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[0-9a-fA-F]{32}$"}},
    "revision": {"type": "integer", "minimum": 0}
  },
  "additionalProperties": false
}
