{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/dialogue-graph.schema.json",
  "title": "Dialogue Intent Graph",
  "type": "object",
  "required": ["entryNodeId", "nodes"],
  "properties": {
    "entryNodeId": {"type": "string", "minLength": 1},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "intent", "speakerSlotId", "textTemplate", "choices", "endsConversation"],
        "properties": {
          "id": {"type": "string"},
          "intent": {"type": "string"},
          "speakerSlotId": {"type": "string"},
          "textTemplate": {"type": "string"},
          "requiredFactSlotId": {"type": "string"},
          "choices": {"type": "array", "items": {"type": "object"}},
          "defaultNextNodeId": {"type": "string"},
          "endsConversation": {"type": "boolean"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
