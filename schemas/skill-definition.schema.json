{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roentgen Skill Definition",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "primaryAttribute": {
      "type": "string",
      "minLength": 1
    },
    "secondaryAttribute": {
      "type": [
        "string",
        "null"
      ]
    },
    "baseValue": {
      "type": "integer"
    },
    "primaryMultiplier": {
      "type": "integer"
    },
    "secondaryMultiplier": {
      "type": "integer"
    }
  },
  "required": [
    "id",
    "primaryAttribute",
    "secondaryAttribute",
    "baseValue",
    "primaryMultiplier",
    "secondaryMultiplier"
  ]
}
