{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.local/schemas/item-transaction.schema.json",
  "title": "Item Transaction",
  "type": "object",
  "required": [
    "transactionId",
    "simulationTick",
    "operations"
  ],
  "properties": {
    "transactionId": {
      "type": "string"
    },
    "simulationTick": {
      "type": "integer",
      "minimum": 0
    },
    "operations": {
      "type": "array",
      "minItems": 1
    }
  },
  "additionalProperties": true
}
