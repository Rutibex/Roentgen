{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/settlement-plan.schema.json",
  "title": "Generated settlement plan",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "siteId",
    "districts",
    "streets",
    "parcels",
    "checksum"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "siteId": {
      "type": "string",
      "minLength": 1
    },
    "districts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "streets": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "parcels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    }
  }
}
