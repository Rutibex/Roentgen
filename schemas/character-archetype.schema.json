{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/character-archetype.schema.json",
  "title": "Roentgen Character Archetype",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "archetypeId",
    "species",
    "heightRangeMillimeters",
    "buildRangePermille"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "archetypeId": {
      "type": "string",
      "minLength": 1
    },
    "species": {
      "enum": [
        "Human",
        "HumanoidMutant",
        "IndustrialQuadruped",
        "RoboticChassis"
      ]
    },
    "heightRangeMillimeters": {
      "$ref": "#/$defs/range"
    },
    "buildRangePermille": {
      "$ref": "#/$defs/range"
    },
    "clothingProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "equipmentPoseProfiles": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "range": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum",
        "maximum"
      ],
      "properties": {
        "minimum": {
          "type": "integer"
        },
        "maximum": {
          "type": "integer"
        }
      }
    }
  }
}
