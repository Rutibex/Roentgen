{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roentgen Build Viability Scenario",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "routes": {
      "type": "array",
      "minItems": 6,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "primarySkill": {
            "type": "string",
            "minLength": 1
          },
          "difficulty": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "requiredBehaviors": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            },
            "uniqueItems": true
          },
          "resolutionFamily": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "primarySkill",
          "difficulty",
          "requiredBehaviors",
          "resolutionFamily"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "id",
    "objective",
    "routes"
  ]
}
