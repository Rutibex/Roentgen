{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roentgen Background",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "attributeAdjustments": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "skillAdjustments": {
      "type": "object",
      "additionalProperties": {
        "type": "integer"
      }
    },
    "knowledgeTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "dialogueTags": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "uniqueItems": true
    },
    "equipmentPackageId": {
      "type": "string",
      "minLength": 1
    },
    "startingBenefitId": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "id",
    "name",
    "description",
    "attributeAdjustments",
    "skillAdjustments",
    "knowledgeTags",
    "dialogueTags",
    "equipmentPackageId",
    "startingBenefitId"
  ]
}
