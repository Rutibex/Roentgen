{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/structure-instance.schema.json",
  "title": "Compiled structure instance",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "parentSiteId",
    "parcelId",
    "name",
    "grammarId",
    "worldOrigin",
    "footprint",
    "floorCount",
    "rooms",
    "doors",
    "primitives",
    "reservations",
    "streamingCells",
    "checksum"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "parentSiteId": {
      "type": "string",
      "minLength": 1
    },
    "parcelId": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "grammarId": {
      "type": "string",
      "minLength": 1
    },
    "worldOrigin": {
      "$ref": "#/$defs/point"
    },
    "footprint": {
      "$ref": "#/$defs/rect"
    },
    "floorCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 4
    },
    "rooms": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "doors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "primitives": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object"
      }
    },
    "reservations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "streamingCells": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object"
      }
    },
    "checksum": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "xCentimeters",
        "yCentimeters",
        "zCentimeters"
      ],
      "properties": {
        "xCentimeters": {
          "type": "integer"
        },
        "yCentimeters": {
          "type": "integer"
        },
        "zCentimeters": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "rect": {
      "type": "object",
      "required": [
        "minimumXCentimeters",
        "minimumZCentimeters",
        "maximumXCentimeters",
        "maximumZCentimeters"
      ],
      "properties": {
        "minimumXCentimeters": {
          "type": "integer"
        },
        "minimumZCentimeters": {
          "type": "integer"
        },
        "maximumXCentimeters": {
          "type": "integer"
        },
        "maximumZCentimeters": {
          "type": "integer"
        }
      },
      "additionalProperties": false
    }
  }
}
