{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/terrain-chunk-manifest.schema.json",
  "title": "Roentgen compiled terrain chunk manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "campaignSeed", "topologyChecksum", "chunks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "campaignSeed": { "type": "integer", "minimum": 0 },
    "topologyChecksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "chunks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["address", "id", "checksum", "estimatedCpuBytes", "lodSamples"],
        "properties": {
          "address": { "type": "string", "pattern": "^-?[0-9]+,-?[0-9]+$" },
          "id": { "type": "string", "minLength": 1 },
          "checksum": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "estimatedCpuBytes": { "type": "integer", "minimum": 1 },
          "lodSamples": {
            "type": "array",
            "prefixItems": [{ "const": 65 }, { "const": 33 }, { "const": 17 }],
            "items": false
          }
        }
      }
    }
  }
}
