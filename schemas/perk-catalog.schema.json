{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Roentgen Perk Catalog",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "const": 1
    },
    "perks": {
      "type": "array",
      "minItems": 40,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "family": {
            "type": "string",
            "minLength": 1
          },
          "maximumRank": {
            "type": "integer",
            "minimum": 1
          },
          "balanceClass": {
            "enum": [
              "Behavior",
              "OptionUnlock",
              "Hybrid",
              "Numerical"
            ]
          },
          "requirements": {
            "type": "array"
          },
          "effects": {
            "type": "array",
            "minItems": 1
          }
        },
        "required": [
          "id",
          "name",
          "description",
          "family",
          "maximumRank",
          "balanceClass",
          "requirements",
          "effects"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schemaVersion",
    "perks"
  ]
}
