{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/material-recipe.schema.json",
  "title": "Roentgen procedural material recipe",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "schemaVersion",
    "width",
    "height",
    "roughness",
    "metallic",
    "emissiveStrength",
    "tileable",
    "layers",
    "metadata"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "^[a-z0-9][a-z0-9._-]*$"
    },
    "schemaVersion": {
      "const": 1
    },
    "width": {
      "type": "integer",
      "minimum": 4,
      "maximum": 2048
    },
    "height": {
      "type": "integer",
      "minimum": 4,
      "maximum": 2048
    },
    "roughness": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "metallic": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "emissiveStrength": {
      "type": "number",
      "minimum": 0
    },
    "tileable": {
      "type": "boolean"
    },
    "metadata": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "layers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "$ref": "#/$defs/layer"
      }
    }
  },
  "$defs": {
    "color": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "r",
        "g",
        "b",
        "a"
      ],
      "properties": {
        "r": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "g": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "b": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        },
        "a": {
          "type": "integer",
          "minimum": 0,
          "maximum": 255
        }
      }
    },
    "layer": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "channel",
        "primary",
        "secondary",
        "opacity",
        "scale",
        "threshold",
        "angleDegrees",
        "seed"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "solid",
            "verticalGradient",
            "checker",
            "valueNoise",
            "rustSpots",
            "scratches",
            "warningStripes",
            "edgeWear",
            "speckles"
          ]
        },
        "channel": {
          "enum": [
            "albedo",
            "roughness",
            "metallic",
            "emissive",
            "height"
          ]
        },
        "primary": {
          "$ref": "#/$defs/color"
        },
        "secondary": {
          "$ref": "#/$defs/color"
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "scale": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "threshold": {
          "type": "number"
        },
        "angleDegrees": {
          "type": "number"
        },
        "seed": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
