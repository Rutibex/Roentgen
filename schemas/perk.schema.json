{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://roentgen.game/schemas/perk.schema.json",
  "title": "Roentgen Perk",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "displayName", "description", "family", "maxRank", "requirements", "effects"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$" },
    "displayName": { "type": "string", "minLength": 1, "maxLength": 80 },
    "description": { "type": "string", "minLength": 1, "maxLength": 600 },
    "family": {
      "type": "string",
      "enum": ["ballistics", "directedEnergy", "demolitions", "melee", "unarmed", "roentgenFocus", "stealthSecurity", "engineeringScience", "medicineFieldcraft", "influenceCommerce", "exploration", "companion", "radiological"]
    },
    "maxRank": { "type": "integer", "minimum": 1, "maximum": 10 },
    "behaviorChanging": { "type": "boolean", "default": true },
    "requirements": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "key", "value"],
        "properties": {
          "kind": { "type": "string", "enum": ["level", "attribute", "skill", "perk", "faction", "discovery", "background", "trait"] },
          "key": { "type": "string" },
          "value": { "type": ["integer", "number", "string", "boolean"] }
        }
      }
    },
    "effects": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["effectType"],
        "properties": {
          "effectType": { "type": "string" },
          "parameters": { "type": "object" }
        }
      }
    },
    "originalityNotes": { "type": "string" }
  }
}
